# ========================================================
# PANDUAN VARIABEL ENVIRONMENT UNTUK RAILWAY
# Copy nilai-nilai ini ke tab "Variables" di Service Railway kamu
# ========================================================

APP_NAME="Catatan Keuangan & Tugas"
APP_ENV=production
APP_KEY=base64:1OVnMJwq... # (Gunakan APP_KEY dari .env lokal kamu atau generate baru)
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stack
LOG_LEVEL=error

# DATABASE (Jika menggunakan Database MySQL dari Railway)
# Railway menyediakan variabel otomatis ini jika kamu Add Database -> MySQL:
DB_CONNECTION=mysql
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_DATABASE=${{MYSQLDATABASE}}
DB_USERNAME=${{MYSQLUSER}}
DB_PASSWORD=${{MYSQLPASSWORD}}

# SESSION & CACHE
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# TELEGRAM BOT (Notifikasi Otomatis)
TELEGRAM_BOT_TOKEN="isi_bot_token_kamu_di_sini"
TELEGRAM_CHAT_ID="isi_chat_id_kamu_di_sini"
TELEGRAM_CRON_KEY="kunci_rahasia_cron_kamu_di_sini"

